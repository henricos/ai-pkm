# Configuração obrigatória — copie para .env.local e preencha com valores reais
PKM_PATH=/absolute/path/to/your/pkm
# INDEX_PATH é opcional em dev local quando a app roda a partir da raiz do repositório.
# Em produção/container, configure explicitamente o path externo dos índices.
# INDEX_PATH=/absolute/path/to/your/index
# APP_ROOT_PATH é opcional e só precisa ser definido se o runtime não iniciar
# a partir da raiz versionada que contém models/, reference/, .agents/skills/ e AGENTS.md.
# APP_ROOT_PATH=/absolute/path/to/your/app-root
AUTH_USERNAME=seu_usuario
AUTH_PASSWORD=senha_segura_minimo_8_chars
NEXTAUTH_SECRET=string_aleatoria_minimo_32_chars
NEXTAUTH_URL=http://localhost:3000
